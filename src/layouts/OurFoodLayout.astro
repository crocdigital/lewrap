---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import {
    resolveFoodSections,
    warnAboutUnmatchedItems,
} from "../utils/foodSections";

// Page Builder components
import Hero from "../components/Hero.astro";
import FoodCard from "../components/FoodCard.astro";
import Button from "../components/atoms/Button.astro";

// Get all food items
const allFood = (await getCollection("food")) as CollectionEntry<"food">[];

// Resolve the client-editable category list (src/data/food-categories.json)
// against the food collection. Order of the array is the order on the page.
const { sections, unmatchedItems } = resolveFoodSections(allFood);
warnAboutUnmatchedItems(unmatchedItems);

const visibleSections = sections.filter((section) => section.hasItems);

// Per-section background treatments. Anything not listed gets the wood tile.
const WOOD_TILE_BACKGROUND =
    "background-image: url('/images/bg-tile-wood.webp'); background-repeat: repeat;";

const SECTION_BACKGROUNDS: Record<string, string> = {
    "protein-packs":
        "background-image: url('/images/elements/protein-pack-bgrd.svg'), url('/images/bg-tile-wood.webp'); \n                            background-repeat: no-repeat, repeat; \n                            background-position: center, top left; \n                            background-size: contain, auto;",
    "kids-meals":
        "background-image: url('/images/elements/kidsmeals-bgrd.webp'), url('/images/bg-tile-wood.webp'); \n                            background-repeat: no-repeat, repeat; \n                            background-position: right, top left; \n                            background-size: 45%, auto;",
};

const backgroundFor = (id: string) =>
    SECTION_BACKGROUNDS[id] ?? WOOD_TILE_BACKGROUND;

const { frontmatter } = Astro.props;
const {
    title,
    hero_title,
    hero_subtitle,
    hero_bg_type,
    hero_bg_colour,
    hero_bg_image,
    hero_bg_image_mobile,
    hero_button_text,
    hero_button_link,
    hero_button_variant,
    latest_deals = [],
} = frontmatter || {};
---

<BaseLayout title={title}>
    <main
        class="max-w-screen-2xl w-full mx-auto text-lewrap-off-black flex flex-col gap-10 relative"
    >
        {
            hero_title && (
                <Hero
                    title={hero_title}
                    show_food_cat_links={true}
                    food_cat_links={visibleSections.map((section) => ({
                        id: section.id,
                        name: section.name,
                    }))}
                    subtitle={hero_subtitle}
                    hero_bg_type={hero_bg_type}
                    hero_bg_colour={hero_bg_colour}
                    hero_bg_image={hero_bg_image}
                    hero_bg_image_mobile={hero_bg_image_mobile}
                    hero_button_text={hero_button_text}
                    hero_button_link={hero_button_link}
                    hero_button_variant={hero_button_variant}
                />
            )
        }

        {/* Latest Deals */}
        {
            latest_deals.length > 0 && (
                <section
                    id="latest-deals"
                    class="scroll-mt-10 md:scroll-mt-16 w-[95%] md:max-w-screen-2xl mx-auto p-7 md:p-21 items-center rounded-xl bg-lewrap-green bg-[radial-gradient(ellipse_50.00%_50.00%_at_50.00%_50.00%,_white_0%,_rgba(255,_255,_255,_0)_100%)]"
                >
                    <div class="relative">
                        <div class="flex flex-col gap-y-8 py-13">
                            <h2 class="text-lewrap-green-dark text-4xl/10 md:text-5xl/11 font-black tracking-tight">
                                Latest Deals
                            </h2>

                            <div
                                class={`grid grid-cols-1 ${latest_deals.length > 1 ? "md:grid-cols-2" : ""} gap-8`}
                            >
                                {latest_deals.map((deal: any) => (
                                    <img
                                        src={deal.image}
                                        alt={deal.alt || "LeWrap deal"}
                                        class="w-full h-auto rounded-2xl"
                                    />
                                ))}
                            </div>
                        </div>

                        <Button
                            href="https://lewrap.redcatcloud.com.au/app/menu"
                            target="_blank"
                            variant="secondary"
                            class="flex mx-auto mb-8"
                        >
                            Order Now
                        </Button>

                        <img
                            src="/images/elements/arrow-darkgreen-regular.svg"
                            alt="More about LeWrap locations"
                            class="w-8 h-auto absolute left-1/2 -translate-x-1/2 z-2 md:-bottom-44"
                        />
                    </div>
                </section>
            )
        }

        {/* Food categories - one section per entry in food-categories.json */}
        {
            visibleSections.map((section) => (
                <section
                    id={section.id}
                    class="scroll-mt-16 w-[95%] md:max-w-screen-2xl mx-auto p-7 md:p-21 items-center rounded-xl"
                    style={backgroundFor(section.id)}
                >
                    <div
                        class={
                            section.subcategories.length > 0
                                ? "flex flex-col gap-y-2 mb-8"
                                : "flex flex-col gap-y-2"
                        }
                    >
                        {section.heading_image ? (
                            <img
                                src={section.heading_image}
                                alt={section.name}
                                class="w-[357px] h-auto"
                            />
                        ) : (
                            <h2 class="text-lewrap-green-dark text-4xl/10 md:text-5xl/11 font-black tracking-tight">
                                {section.name}
                            </h2>
                        )}

                        {section.description && (
                            <p
                                class={
                                    section.subcategories.length > 0
                                        ? "text-lg/7"
                                        : "text-xl/7"
                                }
                            >
                                {section.description}
                            </p>
                        )}

                        {section.subtitle && (
                            <em
                                class={
                                    section.subcategories.length > 0
                                        ? "text-lg/7 font-bold font-italic"
                                        : "text-xl/7 font-bold font-italic"
                                }
                            >
                                {section.subtitle}
                            </em>
                        )}
                    </div>

                    {section.subcategories.map((subcategory) => (
                        <div class="mb-12">
                            <h3 class="text-2xl font-bold text-lewrap-green mb-2">
                                {subcategory.name}
                            </h3>
                            {subcategory.description && (
                                <p class="text-xl mb-1">
                                    {subcategory.description}
                                </p>
                            )}
                            {subcategory.subtitle && (
                                <em class="text-xl font-bold font-italic mb-8 block">
                                    {subcategory.subtitle}
                                </em>
                            )}

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-4">
                                {subcategory.items.map((item) => (
                                    <FoodCard
                                        name={item.data.name}
                                        price={item.data.price}
                                        description={item.data.description}
                                        kj={item.data.kj}
                                        image={item.data.image}
                                        orderLink={item.data.orderLink}
                                        slug={item.slug}
                                    />
                                ))}
                            </div>
                        </div>
                    ))}

                    {section.looseItems.length > 0 && (
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 py-8">
                            {section.looseItems.map((item) => (
                                <FoodCard
                                    name={item.data.name}
                                    price={item.data.price}
                                    description={item.data.description}
                                    kj={item.data.kj}
                                    image={item.data.image}
                                    orderLink={item.data.orderLink}
                                    slug={item.slug}
                                />
                            ))}
                        </div>
                    )}
                </section>
            ))
        }
    </main>
</BaseLayout>
