---
import BaseLayout from "./BaseLayout.astro";
import Button from "../components/atoms/Button.astro";
import { clean, newsroomCategory } from "../utils/content";

const { frontmatter } = Astro.props;
const {
    title,
    hero_image,
    hero_image_mobile,
    category,
    date,
    preview_text,
    seo_title,
    seo_description,
    seo_image,
    seo_keywords,
    seo_robots,
} = frontmatter ?? {};

// Every field below may arrive as null (a field the client cleared in
// CloudCannon), "" or missing. clean() turns all three into undefined so the
// elements can be omitted and the SEO defaults can take over.
const cleanTitle = clean(title);
const cleanPreviewText = clean(preview_text);
const cleanHeroImage = clean(hero_image);
const cleanHeroImageMobile = clean(hero_image_mobile);
const cleanSeoTitle = clean(seo_title);
const cleanSeoDescription = clean(seo_description);
const cleanSeoImage = clean(seo_image);

// A blank or unrecognised category falls back to "Updates", the default the
// select used to carry in the schema.
const cleanCategory = newsroomCategory(category);

// Only the images that actually exist get an absolute URL - new URL(null, site)
// would otherwise resolve to "<site>/null".
const schemaImage = cleanSeoImage ?? cleanHeroImage;
const schemaImageUrl = schemaImage
    ? new URL(schemaImage, Astro.site).href
    : undefined;

// Article Schema for newsroom posts. JSON.stringify drops undefined keys, so a
// blank field leaves the property out rather than emitting null or "".
const articleSchema = {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: cleanSeoTitle ?? cleanTitle,
    description: cleanSeoDescription ?? cleanPreviewText,
    image: schemaImageUrl,
    datePublished: date ? new Date(date).toISOString() : undefined,
    dateModified: date ? new Date(date).toISOString() : undefined,
    author: {
        "@type": "Organization",
        name: "LeWrap",
    },
    publisher: {
        "@type": "Organization",
        name: "LeWrap",
        logo: {
            "@type": "ImageObject",
            url: new URL("/images/logo.png", Astro.site).href,
        },
    },
    articleSection: cleanCategory,
};

// Format date
const articleDate = date ? new Date(date) : undefined;
const formattedDate = articleDate
    ? new Intl.DateTimeFormat("en-AU", {
          day: "numeric",
          month: "long",
          year: "numeric",
      }).format(articleDate)
    : undefined;
---

<BaseLayout
    title={cleanSeoTitle ?? cleanTitle}
    description={cleanSeoDescription ?? cleanPreviewText}
    image={cleanSeoImage ?? cleanHeroImage}
    type="article"
    keywords={clean(seo_keywords)}
    robots={clean(seo_robots) ?? "index, follow"}
    schema={articleSchema}
>
    <article
        class="max-w-screen-2xl w-full mx-auto text-lewrap-off-black flex flex-col gap-10 relative"
    >
        <section
            class="relative flex items-center justify-center mt-10 md:mt-15 w-[95%] mx-auto h-[62vh] md:h-[75vh] rounded-2xl overflow-hidden bg-lewrap-green"
        >
            <div
                class="absolute inset-0 w-full h-full bg-gradient-to-b from-black/0 to-black/40 z-10"
            >
            </div>
            <div
                class="max-w-[930px] relative z-20 flex flex-col items-center justify-center h-full w-full px-6"
            >
                {/* Back Button */}
                <Button
                    href="/newsroom"
                    variant="secondary"
                    class="py-3 px-6 text-sm mb-6"
                >
                    ← Back to Newsroom
                </Button>

                {/* Category */}
                {
                    cleanCategory && (
                        <span class="font-helvetica-condensed font-semibold text-base text-white/75 uppercase">
                            {cleanCategory}
                        </span>
                    )
                }

                {/* Title - omitted entirely when blank */}
                {
                    cleanTitle && (
                        <h1 class="md:w-auto mx-auto text-white text-4xl md:text-[90px] font-bold leading-[100%] tracking-tight text-center mb-6">
                            {cleanTitle}
                        </h1>
                    )
                }

                {/* Date */}
                {
                    articleDate && (
                        <time
                            datetime={articleDate.toISOString()}
                            class="text-xl md:text-2xl leading-tight text-white text-center max-w-2xl px-8 mx-auto"
                        >
                            {formattedDate}
                        </time>
                    )
                }
            </div>
            {
                /* Hero Image - Responsive. Omitted when blank, which leaves the
                   section's bg-lewrap-green showing as the fallback. */
            }
            {
                cleanHeroImage && (
                    <picture class="absolute inset-0 w-full h-full z-0">
                        <source
                            media="(max-width: 768px)"
                            srcset={cleanHeroImageMobile ?? cleanHeroImage}
                        />
                        <img
                            src={cleanHeroImage}
                            alt={cleanTitle ?? ""}
                            class="w-full h-full object-cover"
                        />
                    </picture>
                )
            }
        </section>

        <section
            class="w-[95%] md:max-w-screen-lg mx-auto gap-8 p-7 md:p-21 items-center rounded-xl relative"
        >
            {/* Article Content */}
            <div class="prose prose-lg max-w-none article-content">
                <slot />
            </div>
        </section>
    </article>
</BaseLayout>

<style>
    .article-content :global(h2) {
        color: #2d5016;
        font-size: 1.875rem;
        font-weight: 700;
        margin-top: 3rem;
        margin-bottom: 1rem;
    }

    .article-content :global(h3) {
        color: #2d5016;
        font-size: 1.5rem;
        font-weight: 600;
        margin-top: 2rem;
        margin-bottom: 0.75rem;
    }

    .article-content :global(p) {
        font-size: 1.25rem;
        line-height: 1.75rem;
        margin-bottom: 1.5rem;
    }

    .article-content :global(a) {
        color: #95ba32;
        font-weight: 600;
    }

    .article-content :global(a:hover) {
        text-decoration: underline;
    }

    .article-content :global(strong) {
        color: #2d5016;
    }

    .article-content :global(img) {
        border-radius: 0.75rem;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }

    .article-content :global(ul) {
        list-style-type: disc;
        padding-left: 1.5rem;
    }

    .article-content :global(ol) {
        list-style-type: decimal;
        padding-left: 1.5rem;
    }
</style>
