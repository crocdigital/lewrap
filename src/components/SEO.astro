---
import { clean } from "../utils/content";

interface Props {
    title?: string | null;
    description?: string | null;
    image?: string | null;
    type?: string | null;
    robots?: string | null;
    canonical?: string | null;
    author?: string | null;
    keywords?: string | null;
    schema?: object | null;
}

const {
    title,
    description,
    image,
    type,
    robots,
    canonical,
    author,
    keywords,
    schema,
} = Astro.props;

// Site defaults. Every value below is run through clean(), so null, "" and a
// missing prop all fall back to these rather than rendering a blank tag.
const DEFAULT_TITLE = "LeWrap - Fresh, Healthy Wraps & More";
const DEFAULT_DESCRIPTION =
    "Discover LeWrap's delicious range of fresh wraps, plates, salads and more. Made fresh daily with quality ingredients. Find your nearest LeWrap location.";
const DEFAULT_IMAGE = "/images/og/lewrap-og-default.jpg";
const DEFAULT_TYPE = "website";
const DEFAULT_ROBOTS = "index, follow";
const DEFAULT_AUTHOR = "LeWrap";

const cleanTitle = clean(title) ?? DEFAULT_TITLE;
const cleanDescription = clean(description) ?? DEFAULT_DESCRIPTION;
const cleanImage = clean(image) ?? DEFAULT_IMAGE;
const cleanType = clean(type) ?? DEFAULT_TYPE;
const cleanRobots = clean(robots) ?? DEFAULT_ROBOTS;
const cleanAuthor = clean(author) ?? DEFAULT_AUTHOR;
const cleanKeywords = clean(keywords);

// Add " | LeWrap" to title (the default already ends with the brand)
const pageTitle =
    cleanTitle.endsWith("LeWrap") || cleanTitle.includes(" | LeWrap")
        ? cleanTitle
        : `${cleanTitle} | LeWrap`;

// Get current URL for canonical and OG
const currentUrl = clean(canonical) ?? Astro.url.href;

// Full image URL for OG (needs absolute URL)
const fullImageUrl = new URL(cleanImage, Astro.site || Astro.url.origin).href;

// Default keywords
const defaultKeywords =
    "LeWrap, healthy wraps Australia, fresh wraps Sydney, healthy fast food, fresh lunch options, wrap restaurant, Australian healthy food, quick healthy meals";
const allKeywords = cleanKeywords
    ? `${defaultKeywords}, ${cleanKeywords}`
    : defaultKeywords;
---

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={cleanDescription} />
<meta name="keywords" content={allKeywords} />
<meta name="author" content={cleanAuthor} />
<meta name="robots" content={cleanRobots} />
<link rel="canonical" href={currentUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={cleanType} />
<meta property="og:url" content={currentUrl} />
<meta property="og:title" content={cleanTitle} />
<meta property="og:description" content={cleanDescription} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:site_name" content="LeWrap" />
<meta property="og:locale" content="en_AU" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={currentUrl} />
<meta name="twitter:title" content={cleanTitle} />
<meta name="twitter:description" content={cleanDescription} />
<meta name="twitter:image" content={fullImageUrl} />

<!-- Additional Meta -->
<meta name="format-detection" content="telephone=no" />
<meta name="creator" content="LeWrap" />

<!-- Schema.org JSON-LD -->
{
    schema && (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )
}
