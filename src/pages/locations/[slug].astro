---
// Locations details
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { generateLocationSchema } from "../../utils/generateLocationSchema";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { clean, joinParts } from "../../utils/content";

import Button from "../../components/atoms/Button.astro";

export async function getStaticPaths() {
    const locations = await getCollection("locations");
    return locations.map((location) => ({
        params: { slug: location.slug },
        props: { location },
    }));
}

interface Props {
    location: CollectionEntry<"locations">;
}

const { location } = Astro.props;
const { Content } = await location.render();

// Generate schema
const locationSchema = generateLocationSchema(
    location,
    Astro.site?.toString() || Astro.url.origin,
);

// Every string field may arrive as null (cleared in CloudCannon), "" or
// missing. clean() turns all three into undefined so elements can be omitted
// and the site-wide SEO defaults in SEO.astro can take over.
const name = clean(location.data.name);
const address = clean(location.data.address);
const suburb = clean(location.data.suburb);
const state = clean(location.data.state);
const postcode = clean(location.data.postcode);
const phone = clean(location.data.phone);
const email = clean(location.data.email);
const storeImage = clean(location.data.image);

// "Address, Suburb, STATE 2000" built from whichever parts exist, so a cleared
// field does not leave a stray comma behind.
const addressLine = joinParts([
    address,
    suburb,
    joinParts([state, postcode], " "),
]);

// Get SEO data from location frontmatter - blank falls back to the store name,
// then (in SEO.astro) to the site defaults.
const seoTitle = clean(location.data.seo_title) ?? name;
const descriptionPlace = joinParts([address, suburb]);
const seoDescription =
    clean(location.data.seo_description) ??
    (descriptionPlace
        ? `Visit LeWrap at ${descriptionPlace}. Fresh wraps, salads and more.`
        : undefined);
const seoImage = clean(location.data.seo_image);
const seoKeywords = clean(location.data.seo_keywords);
const seoRobots = clean(location.data.seo_robots) ?? "index, follow";

// Format hours for display
const daysOfWeek = [
    "monday",
    "tuesday",
    "wednesday",
    "thursday",
    "friday",
    "saturday",
    "sunday",
];
const dayLabels: Record<string, string> = {
    monday: "Monday",
    tuesday: "Tuesday",
    wednesday: "Wednesday",
    thursday: "Thursday",
    friday: "Friday",
    saturday: "Saturday",
    sunday: "Sunday",
};
---

<BaseLayout
    title={seoTitle}
    description={seoDescription}
    image={seoImage}
    keywords={seoKeywords}
    robots={seoRobots}
    schema={locationSchema}
>
    <main
        class="max-w-screen-2xl w-full mx-auto text-lewrap-off-black flex flex-col gap-10"
    >
        <div class="relative">
            <section
                class="grid grid-cols-1 md:grid-cols-2 items-center justify-center mt-10 md:mt-15 w-[95%] mx-auto min-h-[62vh] md:min-h-[75vh] rounded-2xl overflow-hidden bg-white"
            >
                {
                    /* Google Map NOTE: THIS MIGHT BREAK WITH LOCATIONS THAT AREN'T INDEXED YET. CHECK BEST WAY TO SOLVE THIS */
                }
                {
                    /* Omitted when there is no name to search for, rather than
                       embedding a map of the literal word "null". */
                }
                {
                    name && (
                        <iframe
                            width="100%"
                            height="100%"
                            style="border:0"
                            loading="lazy"
                            class="min-h-[40vh]"
                            allowfullscreen
                            referrerpolicy="no-referrer-when-downgrade"
                            src={`https://maps.google.com/maps?q=${encodeURIComponent(name)}&tbm=map&output=embed`}
                        />
                    )
                }

                {/* Location details */}
                <div
                    class="flex flex-col p-8 py-10 md:pt-20 items-center justify-center gap-y-6"
                >
                    <div class="flex flex-col items-center">
                        <a
                            href="/locations"
                            class="text-lewrap-green hover:text-lewrap-green-dark font-semibold transition-colors"
                        >
                            ← View all locations
                        </a>

                        {/* Location name - omitted entirely when blank */}
                        {
                            name && (
                                <h1 class="text-5xl md:text-6xl font-black text-lewrap-green-dark text-center">
                                    {name}
                                </h1>
                            )
                        }
                    </div>

                    {
                        /* Wrapper dropped entirely when there is no address,
                           phone or email to put in it. */
                    }
                    {(addressLine || phone || email) && (
                    <div class="flex flex-col text-lg">
                        {/* Address */}
                        {
                            addressLine && (
                                <p class="text-center md:px-31">{addressLine}</p>
                            )
                        }

                        {/* Phone, email */}
                        {
                            phone && (
                                <a
                                    href={`tel:${phone}`}
                                    class="hover:text-lewrap-green text-center duration-200"
                                >
                                    {phone}
                                </a>
                            )
                        }
                        {
                            email && (
                                <a
                                    href={`mailto:${email}?subject=Enquiry%20from%20website`}
                                    class="hover:text-lewrap-green text-center duration-200"
                                >
                                    {email}
                                </a>
                            )
                        }
                    </div>
                    )}

                    {/* View larger map */}
                    <Button
                        href={`https://www.google.com/maps/dir/?api=1&destination=${location.data.latitude},${location.data.longitude}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="px-5 py-3 text-sm"
                    >
                        Get Directions
                    </Button>

                    {/* Hours */}
                    <div class="w-[90%] md:w-[50%]">
                        <h2
                            class="text-3xl font-black text-lewrap-green-dark text-center mb-4"
                        >
                            Hours
                        </h2>
                        <div class="space-y-1">
                            {
                                daysOfWeek.map((day) => (
                                    <div class="flex justify-between items-center text-lg">
                                        <span class="capitalize">
                                            {dayLabels[day]}
                                        </span>
                                        <span
                                            class={`font-bold ${
                                                location.data.hours[
                                                    day as keyof typeof location.data.hours
                                                ] === "Closed"
                                                    ? "text-red-600"
                                                    : ""
                                            }`}
                                        >
                                            {
                                                location.data.hours[
                                                    day as keyof typeof location.data.hours
                                                ]
                                            }
                                        </span>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>

                {/* Arrow */}
                <img
                    src="/images/elements/arrow-green-fat.svg"
                    alt="More about LeWrap locations"
                    class="w-10 h-auto absolute left-1/2 md:left-3/4 -translate-x-1/2 -bottom-14"
                />
            </section>
        </div>

        {/* Location paragraph, image */}
        <section
            class="w-[95%] mx-auto bg-cover bg-center bg-no-repeat p-7 rounded-2xl grid md:grid-cols-2 relative overflow-hidden"
        >
            <div class="max-w-xl mx-auto flex flex-col gap-y-8 py-16">
                {
                    name && (
                        <h2 class="text-4xl/10 md:text-5xl/11 font-black text-lewrap-green-dark">
                            {name}
                        </h2>
                    )
                }

                <div
                    class="prose text-xl/7 text-lewrap-off-black [&_p]:mb-8 [&_p:last-child]:mb-0"
                >
                    <Content />
                </div>
            </div>

            {/* Store Image */}
            {
                storeImage && (
                    <div class="rounded-xl overflow-hidden">
                        <img
                            src={storeImage}
                            alt={name ?? ""}
                            class="w-full h-full object-cover"
                        />
                    </div>
                )
            }

            <img
                src="/images/bgrds/location-detail-bgrd.webp"
                alt="LeWrap"
                class="w-[190px] h-auto absolute -left-10 -z-1 bottom-0"
            />
        </section>

        {/* Find us, contact, order now */}
        <section
            class="w-[95%] max-w-screen-2xl mx-auto bg-cover bg-center bg-no-repeat rounded-2xl overflow-hidden grid md:grid-cols-2"
            style="background-image: url('/images/bg-tile-wood.webp'); background-repeat: repeat;"
        >
            <div
                class="w-full mx-auto flex flex-col p-7 py-16 bg-lewrap-green text-lg/6 text-lewrap-off-black"
            >
                <h2 class="text-4xl font-black text-white mb-4">Find us</h2>
                {/* Address */}
                {addressLine && <p class="w-[80%] mb-6">{addressLine}</p>}
                {/* View larger map */}
                <Button
                    href={`https://www.google.com/maps/dir/?api=1&destination=${location.data.latitude},${location.data.longitude}`}
                    target="_blank"
                    variant="secondary"
                    rel="noopener noreferrer"
                    class="px-5 py-3 text-sm border-none hover:bg-lewrap-green-dark hover:text-lewrap-green"
                >
                    Get Directions
                </Button>

                {/* Heading omitted when there is no phone or email below it */}
                {
                    (phone || email) && (
                        <h2 class="text-4xl font-black text-white mt-10 mb-4">
                            Contact
                        </h2>
                    )
                }
                {/* Phone, email */}
                {
                    phone && (
                        <a
                            href={`tel:${phone}`}
                            class="text-lewrap-green-dark hover:text-white duration-200"
                        >
                            {phone}
                        </a>
                    )
                }
                {
                    email && (
                        <a
                            href={`mailto:${email}?subject=Enquiry%20from%20website`}
                            class="text-lewrap-green-dark hover:text-white duration-200"
                        >
                            {email}
                        </a>
                    )
                }
            </div>

            {/* Order Now */}
            <div
                class="w-full md:w-[85%] mx-auto flex flex-col gap-y-8 p-7 pt-40 py-16 text-2xl/8 items-center justify-end relative"
            >
                <Button
                    href="https://lewrap.redcatcloud.com.au/app/menu"
                    target="_blank"
                    variant="secondary"
                    class="absolute z-1"
                >
                    Order Now
                </Button>

                <img
                    src="/images/pages/welcome-lewrap.webp"
                    alt="LeWrap welcome"
                    class="w-[200px] md:w-[380px] h-auto left-1/2 -translate-x-1/2 absolute mx-auto bottom-0"
                />
            </div>
        </section>
    </main>
</BaseLayout>
